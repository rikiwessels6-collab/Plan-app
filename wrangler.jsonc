{
  // Plan: the app (static files in dist/) and its API (worker/index.ts) as one Cloudflare Worker.
  "name": "plan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "plan", "database_id": "d3ea0b7e-668d-4e30-9bfa-e0fe0a35083f", "migrations_dir": "migrations" }
  ]
}
